# Optional relay URL baked into the launcher at build time.
# Leave unset: packaged builds use https://mcm98-launcher.onrender.com and
# `npm run dev` uses the local relay at http://localhost:8790.
# Set this only to point release builds at a self-hosted relay, for example:
# MAIN_VITE_BACKEND_URL=https://your-service.onrender.com
MAIN_VITE_BACKEND_URL=
